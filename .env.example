# =============================================================================
# Resume Tailoring Platform — Environment Variables
# =============================================================================
# Copy this file to backend/.env and adjust values as needed.
# Never commit a real .env file — only this .env.example is tracked in git.
# =============================================================================

# --- Application ---
# development | test | production
APP_ENV=development
DEBUG=true

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# Defaults cover the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite for V1. Path is relative to the backend/ directory when the API
# is run from there (see docs/setup.md).
DATABASE_URL=sqlite:///./storage/app.db

# --- AI / Ollama ---
# Not used until a later sprint (AI provider abstraction). Configuration
# is established now so the AIProvider layer has a settled contract.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- File uploads ---
# Not used until a later sprint (resume/JD upload). Configuration is
# established now for consistency.
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx

# =============================================================================
# Frontend (frontend/.env)
# =============================================================================
# Copy the line below into frontend/.env if you need to override the
# default API URL (e.g. pointing at a non-default backend port).
# VITE_API_BASE_URL=http://localhost:8000/api/v1
